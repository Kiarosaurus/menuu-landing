# Base de datos (LibSQL / Turso)
# En desarrollo local es opcional (por defecto se usa "file:local.db").
# En producción (Vercel) es necesario para persistir los datos:
TURSO_DATABASE_URL="libsql://tu-base-de-datos.turso.io"
TURSO_AUTH_TOKEN="tu_turso_auth_token_aqui"

# Alternativa opcional si usas DATABASE_URL directa:
# DATABASE_URL="file:local.db"
